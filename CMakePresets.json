{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "description": "Configure Codex API Switcher with the Visual Studio 2026 generator.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs2026",
      "cacheVariables": {
        "BUILD_EXAMPLES": "OFF",
        "RAYLIB_SOURCE_DIR": "${sourceDir}/../raylib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-release",
      "displayName": "Visual Studio 2026 Release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "jobs": 4
    }
  ]
}
